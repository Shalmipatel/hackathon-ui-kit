# Copy this file to .env.local and fill in your own values:
#
#   cp .env.example .env.local
#
# .env.local is gitignored and loaded by Vite when you run npm run dev.

# Your backend gateway URL. The dev server proxies /api, /v1, /tools,
# /websockify, OAuth/integration calls, and transcription through this origin.
VITE_NEOCLAW_API_URL=

# Your gateway access token / API key. Sent as Authorization: Bearer <token>.
# Leave blank if your backend uses browser session cookies instead.
VITE_NEOCLAW_API_KEY=

# Optional: set to 1/true if your backend exposes routes directly (e.g.
# /v1/responses) rather than tunneling them under /api/gw/<path>. When
# unset, the dev server rewrites browser requests to add the /api/gw
# prefix before forwarding upstream.
# VITE_GATEWAY_DIRECT=1

# Direct Google OAuth for Gmail readonly scope. The travel feature uses
# Google Identity Services in the browser so the user can connect their
# Gmail account without going through the OpenClaw identity server.
#
# Setup steps in Google Cloud Console:
#  1. APIs & Services → Library → enable "Gmail API".
#  2. APIs & Services → Credentials → create an OAuth 2.0 Client ID of
#     type "Web application" (or reuse an existing one).
#  3. Under "Authorized JavaScript origins", add:
#         http://localhost:5173
#     (plus your production origin when you deploy).
#  4. Copy the Client ID into the value below. Do NOT copy the Client
#     Secret — browser flows never use it, and pasting it here would
#     ship the secret in the JS bundle.
VITE_GOOGLE_CLIENT_ID=
