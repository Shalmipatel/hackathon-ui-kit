# Copy this file to .env.local and fill in your own values:
#
#   cp .env.example .env.local
#
# .env.local is gitignored and loaded by Vite when you run npm run dev.

# Your backend gateway URL. The dev server proxies /api, /v1, /tools,
# /websockify, OAuth/integration calls, and transcription through this origin.
VITE_NEOCLAW_API_URL=

# Your gateway access token / API key. Sent as Authorization: Bearer <token>.
# Leave blank if your backend uses browser session cookies instead.
VITE_NEOCLAW_API_KEY=

# Optional: set to 1/true if your backend exposes routes directly (e.g.
# /v1/responses) rather than tunneling them under /api/gw/<path>. When
# unset, the dev server rewrites browser requests to add the /api/gw
# prefix before forwarding upstream.
# VITE_GATEWAY_DIRECT=1

# Firebase Realtime Database — used by the travel feature to persist
# trips + bookings server-side. All four vars below are required; if
# any are missing, the sync layer no-ops and the app falls back to
# localStorage only.
#
# Find these in the Firebase console:
#   Project settings → "Your apps" → Web app → "SDK setup and
#   configuration" → Config.
# DATABASE_URL is in the Realtime Database tab — looks like
# https://<project-id>-default-rtdb.firebaseio.com
#
# Hackathon mode (no users): paste these rules into RTDB → Rules:
#   {
#     "rules": {
#       "wanderbot": { ".read": true, ".write": true }
#     }
#   }
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional — most apps don't need these for RTDB only:
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
