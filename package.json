{
  "name": "superparent-starter",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Starter UI kit for building a personal AI assistant. React + Vite + TypeScript. Bring your own backend.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run verify:no-dev-code",
