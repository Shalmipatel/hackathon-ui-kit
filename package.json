    "@novnc/novnc": "~1.5.0",
    "@vercel/functions": "^3.7.5",
    "@vercel/og": "^0.11.1",
    "firebase": "^12.13.0",
    "hash-wasm": "^4.12.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^10.1.0",
    "remark-definition-list": "^2.0.0",
    "remark-gfm": "^4.0.1",
    "spectrum-ts": "^9.1.0",
